{
  "version": 1,
  "bindings": [
    {
      "role": "roles/agentgateway.supportViewer",
      "title": "Tier 1 Support Agent Role",
      "description": "Read-only access to customer orders and profile information",
      "members": [
        "spiffe://${PROJECT_ID}.agentplatform.id.goog/agent/tier1-support-agent",
        "principal://agentidentity.googleapis.com/projects/${PROJECT_ID}/locations/global/agentIdentities/tier1-support-agent"
      ],
      "permissions": [
        "tools.customers.get",
        "tools.orders.get",
        "services.customerData.read"
      ]
    },
    {
      "role": "roles/agentgateway.billingAdmin",
      "title": "Billing Specialist Role",
      "description": "Authorized to query records and issue refunds",
      "members": [
        "spiffe://${PROJECT_ID}.agentplatform.id.goog/agent/billing-specialist",
        "principal://agentidentity.googleapis.com/projects/${PROJECT_ID}/locations/global/agentIdentities/billing-specialist"
      ],
      "permissions": [
        "tools.customers.get",
        "tools.orders.get",
        "tools.payments.refund",
        "services.customerData.read",
        "services.paymentProcessing.write"
      ]
    },
    {
      "role": "roles/agentgateway.securityAdmin",
      "title": "Security Administrator Role",
      "description": "Full administrative control over user accounts and permissions",
      "members": [
        "spiffe://${PROJECT_ID}.agentplatform.id.goog/agent/secops-admin",
        "principal://agentidentity.googleapis.com/projects/${PROJECT_ID}/locations/global/agentIdentities/secops-admin"
      ],
      "permissions": [
        "tools.customers.get",
        "tools.orders.get",
        "tools.identity.delete",
        "tools.identity.overrideRole",
        "services.customerData.read",
        "services.identityAdmin.write"
      ]
    }
  ],
  "tool_registry": {
    "view_customer_profile": {
      "required_permission": "tools.customers.get",
      "target_service": "customerData",
      "description": "Retrieve customer demographic and account profile."
    },
    "lookup_order": {
      "required_permission": "tools.orders.get",
      "target_service": "customerData",
      "description": "Check status and history of a specific order."
    },
    "issue_refund": {
      "required_permission": "tools.payments.refund",
      "target_service": "paymentProcessing",
      "description": "Issue a financial refund for an order (Restricted)."
    },
    "delete_account": {
      "required_permission": "tools.identity.delete",
      "target_service": "identityAdmin",
      "description": "Permanently delete a customer account (Restricted)."
    }
  }
}
